{
  "name": "prisma-ltree",
  "version": "0.3.0",
  "description": "Prisma Next (8.0.0-rc) extension pack for PostgreSQL's ltree hierarchical tree data type.",
  "homepage": "https://prisma-ltree.procka.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slovakian/prisma-ltree.git",
    "directory": "packages/extension-ltree"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./codec-types": "./dist/codec-types.mjs",
    "./column-types": "./dist/column-types.mjs",
    "./control": "./dist/control.mjs",
    "./operation-types": "./dist/operation-types.mjs",
    "./pack": "./dist/pack.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "build:contract-space": "prisma contract emit",
    "check-pins": "node ./scripts/check-pins.mjs"
  },
  "dependencies": {
    "@prisma/orm-family-sql": "8.0.0-rc.5",
    "@prisma/orm-framework": "8.0.0-rc.5",
    "@prisma/orm-toolchain": "8.0.0-rc.5",
    "@standard-schema/spec": "^1.1.0",
    "arktype": "^2.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@prisma/cli-engine": "0.2.0",
    "@prisma/orm-postgres": "8.0.0-rc.5",
    "@prisma/orm-target-postgres": "8.0.0-rc.5",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@vitest/coverage-v8": "4.1.8",
    "prisma": "8.0.0-rc.9",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@prisma/orm-target-postgres": "8.0.0-rc.5",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "@prisma/orm-target-postgres": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "prismaNext": {
    "family": "sql",
    "dialects": [
      "postgres"
    ],
    "type": "extension-pack"
  }
}
