// use prisma

types {
  Path = ltree.Ltree()
  Paths = ltree.LtreeArray()
}

model Page {
  id          Char(36) @id @default(uuid())
  path        Path
  breadcrumbs Paths

  @@index([path], type: "gist", map: "page_path_gist_idx")
  @@index([breadcrumbs], type: "gist", map: "page_breadcrumbs_gist_idx")
  @@map("page")
}
